.row.mb-4.app-hero.app-hero-sky
  .col-12
    %h1.fw-bold.mb-1 Applications & Invitations
    %p.text-muted.mb-0 Review invitations and track the jobs you have applied to.

- if @pending_job_invitations.any?
  %section.mb-4{ data: { pending_invitations: true } }
    %h2.h4.fw-semibold.mb-3 Invitations to Apply
    .row.g-3
      - @pending_job_invitations.each do |invitation|
        .col-12
          .card.border-0.shadow-sm.card-accent.card-accent-cyan
            .card-body.p-4
              .d-flex.flex-column.flex-lg-row.justify-content-between.align-items-lg-start.gap-3
                %div
                  %h3.h5.fw-semibold.mb-2= link_to invitation.job.title, usr_job_path(invitation.job), class: "text-dark text-decoration-none"
                  %p.text-muted.mb-1= invitation.job.company.name
                  %p.text-muted.small.mb-0
                    Invited by
                    = invitation.invited_by.full_name
                .d-flex.flex-wrap.gap-2
                  = link_to "View job", usr_job_path(invitation.job), class: "btn btn-quiet"
                  = link_to "Apply now", accept_usr_job_invitation_path(invitation), class: "btn btn-primary", data: { turbo_method: :patch }
                  = link_to "Decline", decline_usr_job_invitation_path(invitation), class: "btn btn-outline-danger", data: { turbo_method: :patch, turbo_confirm: "Decline this invitation?" }
              = form_with url: usr_job_invitation_contextual_messages_path(invitation), scope: :contextual_message, class: "d-flex gap-2 mt-3" do |form|
                = form.label :body, "Message about this invitation", class: "visually-hidden"
                = form.text_field :body, styled: true, class: "form-control", required: true, maxlength: 5000, placeholder: "Ask about this invitation"
                = form.submit "Send", class: "btn btn-outline-primary"

%section.mb-4
  %h2.h4.fw-semibold.mb-3 My Applications
- if @job_applications.any?
  .row.g-3
    - @job_applications.each do |job_application|
      - job = job_application.job
      .col-12
        .card.border-0.shadow-sm.h-100.card-accent.card-accent-sky
          .card-body.p-4
            .d-flex.flex-column.flex-lg-row.justify-content-between.align-items-lg-start.gap-3
              .flex-grow-1
                %h4.fw-semibold.mb-2= link_to job.title, usr_job_application_path(job_application), class: "text-dark text-decoration-none"
                %p.text-muted.mb-2
                  - if job.company.present?
                    = link_to job.company.name, usr_company_path(job.company), class: "text-muted text-decoration-none"
                  - else
                    Unassigned Company
                .d-flex.flex-wrap.align-items-center.gap-2.text-muted.small
                  %span{ class: job_application_status_badge_class(job_application.status) }
                    %i.bi.bi-patch-check.me-1
                    = job_application.status.humanize
                  %span •
                  %span
                    %i.bi.bi-clock.me-1
                    Applied
                    = l(job_application.submitted_at&.to_date || job_application.created_at.to_date, format: :long)
              .text-lg-end
                = link_to "View Application", usr_job_application_path(job_application), class: "btn btn-quiet"
- else
  .row
    .col-12
      .card.border-0.shadow-sm
        .card-body.p-4.empty-state.empty-state-sky
          %h5.fw-semibold.mb-2 No Applications Yet
          %p.text-muted.mb-0 You have not submitted any job applications yet.

- if @past_job_invitations.any?
  %section.mt-4{ data: { invitation_history: true } }
    %h2.h4.fw-semibold.mb-3 Invitation History
    .card.border-0.shadow-sm
      .list-group.list-group-flush
        - @past_job_invitations.each do |invitation|
          .list-group-item.d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.gap-2.p-3
            %div
              .fw-semibold= invitation.job.title
              .text-muted.small= invitation.job.company.name
            %span.status-badge{ class: invitation.accepted? ? "status-completed" : "status-unavailable" }
              = invitation.status.humanize
