.row.mb-4
  .col-sm-12
    %h1.fw-bold.mb-1= @job.project ? "Add a Job Posting" : "Create a New Job"
    %p.text-muted.mb-0
      - if @job.project
        Add a role to #{@job.project.name} for #{@company.name}.
      - else
        Add a new role for #{@company.name}.

.row.mt-4
  .col-sm-12
    = render Usr::Company::JobFormComponent.new(company: @company, job: @job, projects: @projects, occupations: @occupations, skills: @skills, equipment: @equipment, requirement_selections: @requirement_selections, entitlement: @entitlement)
