.app-hero.app-hero-cyan.mb-4
  .d-flex.align-items-center.gap-3
    %span.icon-orb.icon-orb-cyan
      %i.bi.bi-bell{ aria: { hidden: true } }
    %h1.fw-bold.mb-0 Notifications

- if @unread_notifications.any? || @read_notifications.any?
  - if @unread_notifications.any?
    .d-flex.flex-column.gap-3{ data: { notifications_section: "unread" } }
      - @unread_notifications.each do |notification|
        = render Usr::NotificationCardComponent.new(notification:)

  - if @read_notifications.any?
    %section{ data: { notifications_section: "read" }, aria: { labelledby: "readNotificationsHeading" } }
      .notifications-divider.d-flex.align-items-center.gap-3.my-4
        %span#readNotificationsHeading.text-muted.small.fw-semibold Read
        %hr.flex-grow-1.my-0
        = link_to "Clear All", clear_read_usr_notifications_path,
          class: "notification-action-link text-secondary",
          data: { turbo_method: :delete, turbo_confirm: "Clear all read notifications?" }
      .d-flex.flex-column.gap-3
        - @read_notifications.each do |notification|
          = render Usr::NotificationCardComponent.new(notification:)
- else
  .empty-state.empty-state-cyan
    %span.icon-orb.icon-orb-cyan
      %i.bi.bi-bell{ aria: { hidden: true } }
    %p.text-muted.mb-0 You have no notifications yet.
