.d-flex.justify-content-between.align-items-start.gap-3.mb-4
  %div
    %div.text-muted.small= @conversation.context_label
    %h1.fw-bold.mb-0= @conversation.title
  = link_to "Back to messages", usr_conversations_path, class: "btn btn-quiet"

= turbo_stream_from @conversation, current_user
= render Usr::ConversationThreadComponent.new(conversation: @conversation, messages: @messages, current_user:) do |thread|
  - @messages.each do |message|
    - thread.with_message_bubble(message:, current_user:)
