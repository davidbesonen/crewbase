.staffing-form.staffing-form--project
  .row.mb-4
    .col-12
      %h1.fw-bold.mb-1 Start A Tour / Festival Project
      %p.text-muted.mb-0= "Start a project for #{@company.name}, then add your shows and plan crew across the run."

  .row
    .col-12
      - if @project.errors[:base].any?
        .alert.alert-warning{ data: { plan_limit_message: true } }= @project.errors[:base].to_sentence
      = render Usr::Company::ProjectFormComponent.new(company: @company, project: @project)
