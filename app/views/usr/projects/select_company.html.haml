.row.mb-4
  .col-12
    %h1.fw-bold.mb-1 Choose A Company
    %p.text-muted.mb-0 Choose the company whose tour or festival you’re planning. Tours, festivals and multi-show events start as Projects.

.row.g-3
  - @companies.each do |company|
    .col-12.col-xl-6
      = render Usr::Company::ProjectCardComponent.new(company: company, projects: @projects_by_company.fetch(company.id, []))
