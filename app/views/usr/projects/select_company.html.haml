.row.mb-4
  .col-12
    %h1.fw-bold.mb-1 Choose A Company
    %p.text-muted.mb-0 Start a new project or pick up where you left off with one of your companies.

.row.g-3
  - @companies.each do |company|
    .col-12.col-xl-6
      = render Usr::Company::ProjectCardComponent.new(company: company, projects: @projects_by_company.fetch(company.id, []))
