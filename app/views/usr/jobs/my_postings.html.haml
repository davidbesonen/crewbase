.row.mb-4
  .col-12.d-flex.flex-wrap.align-items-start.justify-content-between.gap-3
    %div
      %h1.fw-bold.mb-1 My Job Postings
      %p.text-muted.mb-0 Manage job postings across the companies you own.
    = link_to "Post a Job", select_company_usr_jobs_path, class: "btn btn-primary"

.row.g-3
  - if @jobs.any?
    - @jobs.each do |job|
      .col-12
        .card.border-0.shadow-sm.card-accent.card-accent-sky
          .card-body.p-4
            .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-start.gap-3
              %div
                %h4.fw-semibold.mb-2= link_to job.title, usr_job_path(job), class: "text-dark text-decoration-none"
                .text-muted.mb-2= job.company.name
                .d-flex.flex-wrap.gap-2.text-muted.small
                  %span{ class: job_status_badge_class(job.status) }= job.status.humanize
                  %span •
                  %span= job.employment_type.humanize
                  %span •
                  %span= job.workplace_type.humanize
                  %span •
                  %span= job.formatted_location
              .d-flex.flex-wrap.gap-2
                = link_to "View", usr_job_path(job), class: "btn btn-quiet"
                = link_to "Edit", edit_usr_company_job_path(job.company, job), class: "btn btn-outline-primary"
  - else
    .col-12
      .card.border-0.shadow-sm
        .card-body.p-4.empty-state.empty-state-sky
          %h5.fw-semibold.mb-2 No Job Postings Yet
          %p.text-muted.mb-0 Post a job for one of your companies to start finding crew.
