.profile-show
  .card.profile-hero.app-hero.app-hero-cyan.border-0.shadow-sm
    .card-body
      .profile-hero__layout
        .profile-hero__avatar
          = render Usr::Shared::UserAvatarIconComponent.new(user: @profile.user, size: 112)
        .profile-hero__identity
          %h1.mb-2= @profile_name
          %p.profile-hero__headline.text-muted.mb-3= @profile_headline
          %p.profile-hero__meta.d-flex.flex-wrap.align-items-center.text-muted.mb-0
            %span
              %strong
                %i.bi.bi-person-workspace.me-1
            %span.me-2= @location_text
            - if @profile_occupation_names.present?
              %span.me-2 •
              %span= @profile_occupation_names
            - if current_user == @profile.user
              %span.badge.text-bg-light.border.ms-2
                Your Profile
          .profile-hero__socials.d-flex.flex-wrap.gap-2.mt-3
            - if @profile.website_url.present?
              = link_to @profile.website_url, target: "_blank", rel: "noopener", class: "social-link", aria: { label: "Website" }, title: "Website" do
                %i.bi.bi-globe{ aria: { hidden: true } }
            - if @profile.linkedin_url.present?
              = link_to @profile.linkedin_url, target: "_blank", rel: "noopener", class: "social-link", aria: { label: "LinkedIn" }, title: "LinkedIn" do
                %i.bi.bi-linkedin{ aria: { hidden: true } }
            - if @profile.twitter_handle.present?
              = link_to "https://twitter.com/#{@profile.twitter_handle.delete_prefix("@")}", target: "_blank", rel: "noopener", class: "social-link", aria: { label: "X (Twitter)" }, title: "X (Twitter)" do
                %i.bi.bi-twitter-x{ aria: { hidden: true } }
            - if @profile.instagram_handle.present?
              = link_to "https://instagram.com/#{@profile.instagram_handle.delete_prefix("@")}", target: "_blank", rel: "noopener", class: "social-link", aria: { label: "Instagram" }, title: "Instagram" do
                %i.bi.bi-instagram{ aria: { hidden: true } }
            - if @profile.spotify_profile_url.present?
              = link_to @profile.spotify_profile_url, target: "_blank", rel: "noopener", class: "social-link", aria: { label: "Spotify" }, title: "Spotify" do
                %i.bi.bi-spotify{ aria: { hidden: true } }
      .profile-hero__actions
        - if current_user != @profile.user
          .d-flex.flex-wrap.gap-2
            - if @profile.profile_type == "user" && @profile.completed_at? && !@profile_contact_blocked
              = render Usr::Network::ConnectionActionsComponent.new(profile: @profile, connection: @network_connection, viewer: current_user)
            - @available_crew_shortlists.each do |shortlist|
              = button_to usr_crew_shortlist_memberships_path(shortlist), params: { profile_id: @profile.id }, class: "btn btn-outline-primary" do
                %i.bi.bi-bookmark-plus.me-1{ aria: { hidden: true } }
                = "Add to #{shortlist.name}"
            = link_to new_usr_profile_review_path(@profile), class: "btn btn-outline-primary", data: { turbo_frame: "remote_modal" } do
              %i.bi.bi-chat-square-text{ aria: { hidden: true } }
              Write a Review
        - if current_user == @profile.user
          .d-flex.flex-wrap.align-items-center.gap-2
            = link_to usr_settings_path, class: "btn btn-outline-secondary" do
              %i.bi.bi-gear.me-1{ aria: { hidden: true } }
              Settings
            = link_to edit_usr_profile_path(@profile, source: "completed_profile"), class: "btn btn-primary", aria: { label: "Edit Profile" } do
              %i.bi.bi-pencil.me-1{ aria: { hidden: true } }
              Edit Profile

  .row.mt-3
    .col-12
      .card.border-0.shadow-sm.card-accent.card-accent-cyan{ id: "profile-about" }
        .card-body
          .row
            .col-lg-4.profile-snapshot
              %h5.card-section-title.fw-bold Snapshot
              - @about_items.each do |item|
                .d-flex.mb-3
                  .text-secondary.me-3
                    %i.bi{ class: item[:icon] }
                  %div
                    %div.fw-semibold= item[:label]
                    %div.text-muted= item[:value]
              - if @can_view_profile_reviews
                .mt-2{ data: { profile_review_summary: true } }
                  %div.fw-semibold.mb-1 Reviews
                  %div.text-muted
                    - if @review_count.positive?
                      = "#{@review_count} review#{'s' unless @review_count == 1}"
                    - else
                      No reviews yet
            .col-lg-8.mt-3.mt-lg-0
              .d-flex.justify-content-between.align-items-start.flex-wrap.mb-3
                %div
                  %h5.card-section-title.fw-bold About
                - if @can_view_profile_reviews && @average_rating.present?
                  %span.badge.text-bg-light.border.rounded-pill.mt-2.mt-sm-0
                    = "#{@average_rating.round(1)} / 5 rating"
              %p.text-muted.mb-0
                = @profile.bio.presence || "Add a short bio to describe your background, specialties, and the kind of projects you want to work on."

    - if @profile.user == current_user
      .col-12.mt-3
        = render Usr::ProfileAvailabilityComponent.new(overview: @availability_overview, availability_path: edit_calendar_usr_profile_path(@profile))

    - if @profile.user != current_user && @invitable_jobs.any? && !@profile_contact_blocked
      .col-12.mt-3
        .card.profile-invitation.border-0.shadow-sm
          .card-body
            %h5.card-section-title.fw-bold Invite To Apply
            = form_with url: usr_profile_job_invitations_path(@profile), scope: :job_invitation, class: "d-flex flex-column flex-md-row gap-2" do |form|
              = form.collection_select :job_id, @invitable_jobs, :id, ->(job) { "#{job.title} — #{job.company.name}" }, { prompt: "Choose an active job", label: false }, { class: "form-select", required: true, aria: { label: "Job to invite this person to" } }
              = form.button type: "submit", class: "btn btn-primary flex-shrink-0" do
                %i.bi.bi-send{ aria: { hidden: true } }
                Send Invitation

    .col-12.mt-3
      .card.border-0.shadow-sm.card-accent.card-accent-sky{ id: "profile-experience" }
        .card-body
          .profile-section-heading.d-flex.flex-wrap.align-items-center.gap-2
            %h5.card-section-title.fw-bold.mb-0 Experience
            %p.text-muted.small.mb-0.me-auto Self-reported professional roles and experience.
            - if current_user == @profile.user
              = link_to edit_usr_profile_path(@profile, source: "completed_profile", add_experience: 1, anchor: "experience_form"),
                class: "btn btn-outline-primary",
                aria: { label: "Add experience" },
                title: "Add experience" do
                %i.bi.bi-plus-lg{ aria: { hidden: true } }
                Add experience
          - if @experiences.any?
            - @experiences.each_with_index do |experience, index|
              .profile-experience-entry{ class: ("border-top" if index.positive?) }
                .profile-experience-entry__heading.d-flex.justify-content-between.align-items-start.flex-wrap.gap-3
                  .d-flex.align-items-start.gap-3
                    - if experience.company.present?
                      %div{ data: { experience_company_icon: true } }
                        = render Usr::Shared::CompanyIconComponent.new(company: experience.company, size: 56)
                    %div
                      %h5.fw-bold.mb-1= experience.title
                      - if experience.company.present?
                        %p.text-muted.mb-0
                          = link_to experience.company.name, usr_company_path(experience.company), class: "text-muted text-decoration-none fw-semibold"
                          - if experience.company.industries.any?
                            %span.mx-1 •
                            %span= experience.company.industry_names_text
                          - if experience.company.formatted_location.present?
                            %span.mx-1 •
                            %span= experience.company.formatted_location
                      - else
                        %p.text-muted.mb-0= experience.company_name
                  %span.badge.text-bg-light.border.rounded-pill.mt-2.mt-sm-0= experience.display_timeframe
                - if experience.summary.body.present?
                  .experience-summary.text-muted.mt-3{ data: { controller: "expandable-text" } }
                    .experience-summary-content{ data: { expandable_text_target: "content" } }
                      = experience.summary
                    %button.btn.btn-link.p-0.d-none.experience-summary-toggle{
                      type: "button",
                      data: { expandable_text_target: "toggle", action: "expandable-text#toggle" },
                      aria: { expanded: "false" }
                    } …more
                - else
                  %p.text-muted.mt-3.mb-0 No summary added.
          - else
            %p.text-muted.mt-3.mb-0 No experience added yet.

    - if @profile.show_credits? || current_user == @profile.user
      .col-12.mt-3
        = render Usr::ProfileCreditsComponent.new(credits: @credits, owner_view: current_user == @profile.user, visible: @profile.show_credits?)

    .col-12.mt-3
      .card.border-0.shadow-sm{ id: "profile-skills" }
        .card-body
          .row
            .col-lg-6
              %h5.card-section-title.fw-bold Skills & Services
              - if @capability_names.any?
                %p.text-muted.small.mb-2 Capabilities confirmed by this member
                .d-flex.flex-wrap.mb-2
                  - @capability_names.each do |name|
                    %span.badge.rounded-pill.text-bg-primary.me-2.mb-2= name
              - if @reported_skills.any?
                .d-flex.flex-wrap
                  - @reported_skills.each do |skill|
                    %span.badge.rounded-pill.text-bg-light.border.me-2.mb-2= skill
              - else
                %p.text-muted.mb-0 No skills listed yet.
            .col-lg-6.mt-3.mt-lg-0
              %h5.card-section-title.fw-bold Equipment & Software
              - if @equipment_family_names.any?
                %p.text-muted.small.mb-2 Equipment families confirmed by this member
                .d-flex.flex-wrap.mb-2
                  - @equipment_family_names.each do |name|
                    %span.badge.rounded-pill.text-bg-primary.me-2.mb-2= name
              - if @reported_equipment.any?
                .d-flex.flex-wrap
                  - @reported_equipment.each do |item|
                    %span.badge.rounded-pill.text-bg-light.border.me-2.mb-2= item
              - else
                %p.text-muted.mb-0 No equipment or software listed yet.

    - if @profile.work_examples.present?
      .col-12.mt-3
        .card.border-0.shadow-sm{ id: "profile-work-examples" }
          .card-body
            %h5.card-section-title.fw-bold Specialties & Experience Examples
            %p.text-muted.small Specific experience shared by this member. Experience entries describe reported familiarity; employers verify role-specific qualifications.
            = simple_format(@profile.work_examples)

    - if @can_view_profile_reviews
      .col-12.mt-3
        .card.border-0.shadow-sm{ id: "profile-reviews" }
          .card-body
            .row
              .col-lg-4
                %h5.card-section-title.fw-bold Rating Summary
                %div.display-6.fw-bold.mb-1= @average_rating.present? ? @average_rating.round(1) : "N/A"
                %p.text-muted.mb-0
                  - if @review_count.positive?
                    = "Based on #{@review_count} review#{'s' unless @review_count == 1}."
                  - else
                    No reviews yet. This section can surface reliability, communication, and on-set performance once feedback is added.
              .col-lg-8.mt-3.mt-lg-0
                %h5.card-section-title.fw-bold Recent Feedback
                - if @recent_reviews.any?
                  - @recent_reviews.each do |review|
                    .profile-feedback.border.rounded-3.p-3.mb-3
                      .d-flex.justify-content-between.align-items-start.flex-wrap
                        %div.fw-semibold= review.profile.user.full_name
                        - if review.overall_rating.present?
                          %span.badge.text-bg-light.border.rounded-pill.mt-2.mt-sm-0= "#{review.overall_rating.round(1)} / 5"
                      %p.text-muted.small.mb-2= review.created_at.strftime("%B %-d, %Y")
                      %p.mb-0= review.body.presence || "No written feedback provided."
                      = link_to "Report or dispute review", new_usr_report_path(subject_type: "Review", subject_id: review.id, category: "incorrect_review"), class: "btn btn-sm btn-outline-secondary mt-2"
                - else
                  %p.text-muted.mb-0 No written feedback yet.

= render Usr::ProfileSafetyComponent.new(profile: @profile, block: @profile_block, blocked: @profile_contact_blocked, own_profile: current_user == @profile.user)
