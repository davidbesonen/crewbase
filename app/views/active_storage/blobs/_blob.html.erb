<figure class="attachment attachment--file">
  <% if UploadPolicy::IMAGE_TYPES.include?(blob.content_type) %>
    <%= image_tag main_app.rails_service_blob_path(blob.signed_id, blob.filename, inline: "1"), alt: blob.filename.to_s, loading: "lazy" %>
  <% end %>
  <figcaption class="attachment__caption">
    <%= link_to blob.filename.to_s, main_app.rails_service_blob_path(blob.signed_id, blob.filename) %>
    <span class="attachment__size"><%= number_to_human_size blob.byte_size %></span>
  </figcaption>
</figure>
