.d-flex.justify-content-between.align-items-center.mb-4
  %div
    %h1.h2.mb-1 Product updates
    %p.text-muted.mb-0 Write public updates in language prospective users can understand.
  = link_to "New update", new_admin_change_log_entry_path, class: "btn btn-primary"
- @change_log_entries.each do |entry|
  .card.mb-3
    .card-body
      .d-flex.justify-content-between.gap-3
        %div
          %h2.h5= entry.title
          %p.mb-1= entry.summary
          %small.text-muted= entry.published? ? "Published #{l(entry.published_at.to_date, format: :long)}" : "Draft"
        .d-flex.gap-2
          = link_to "Edit", edit_admin_change_log_entry_path(entry), class: "btn btn-outline-primary btn-sm"
          = button_to "Delete", admin_change_log_entry_path(entry), method: :delete, class: "btn btn-outline-danger btn-sm", data: { turbo_confirm: "Delete this update?" }
