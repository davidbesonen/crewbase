.container-fluid.py-4
  .d-flex.justify-content-between.align-items-center.mb-4
    %h1.mb-0 Users
    = form_with url: admin_users_path, method: :get, builder: ActionView::Helpers::FormBuilder, class: "d-flex gap-2", data: { turbo_frame: "_top" } do |form|
      = form.search_field :q, value: params[:q], class: "form-control", placeholder: "Search users", aria: { label: "Search users" }
      = form.submit "Search", class: "btn btn-primary"

  .card
    .table-responsive
      %table.table.table-hover.align-middle.mb-0
        %thead
          %tr
            %th Name
            %th Email
            %th Profile
            %th Companies
            %th Roles
            %th Joined
        %tbody
          - @users.each do |user|
            %tr
              %td= user.full_name
              %td= user.email
              %td= user.profiles.any?(&:completed_at?) ? "Complete" : "Incomplete"
              %td= user.companies.length
              %td= user.roles.map(&:pretty_name).compact.to_sentence.presence || user.roles.map(&:name).to_sentence.presence || "Member"
              %td= l(user.created_at.to_date, format: :long)
  - if @pagy.pages > 1
    .mt-4.d-flex.justify-content-end= bootstrap_pagy_nav(@pagy)
