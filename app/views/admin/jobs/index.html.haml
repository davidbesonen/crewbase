.container-fluid.py-4
  .d-flex.flex-wrap.justify-content-between.align-items-center.gap-3.mb-4
    %h1.mb-0 Jobs
    = form_with url: admin_jobs_path, method: :get, builder: ActionView::Helpers::FormBuilder, class: "d-flex flex-wrap gap-2" do |form|
      = form.search_field :q, value: params[:q], class: "form-control", placeholder: "Search jobs", aria: { label: "Search jobs" }
      = form.select :status, Job.statuses.keys.map { |status| [status.humanize, status] }, { include_blank: "All statuses", selected: params[:status] }, class: "form-select", aria: { label: "Posting status" }
      = form.select :restricted, [["Restricted", "yes"], ["Unrestricted", "no"]], { include_blank: "All access states", selected: params[:restricted] }, class: "form-select", aria: { label: "Access state" }
      = form.submit "Filter", class: "btn btn-primary"
  - if @jobs.empty?
    .alert.alert-light No matching jobs. Try a different search.
  .card
    .table-responsive
      %table.table.table-hover.align-middle.mb-0
        %thead
          %tr
            %th Job
            %th Company
            %th Status
            %th Type
            %th Applications
            %th Access
            %th Created
        %tbody
          - @jobs.each do |job|
            %tr
              %td.fw-semibold= link_to job.title, admin_job_path(job)
              %td= job.company ? link_to(job.company.name, admin_company_path(job.company)) : "Unassigned"
              %td= job.status.humanize
              %td= job.posting_type_label
              %td= job.job_applications.length
              %td= job.restricted_at? ? "Restricted" : "Unrestricted"
              %td= l(job.created_at.to_date, format: :long)
  = link_to "Clear filters", admin_jobs_path, class: "btn btn-link mt-2"
  - if @pagy.pages > 1
    .mt-4.d-flex.justify-content-end= bootstrap_pagy_nav(@pagy)
