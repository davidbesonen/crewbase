-# Shared desktop/drawer markup; keep layout-partial migration separate from visual changes.
.card.user-sidenav-card.workspace-sidenav
  .card-body
    .workspace-sidenav__identity
      = render Usr::Shared::UserAvatarIconComponent.new(user: current_user, size: 44)
      .workspace-sidenav__identity-copy
        %span.workspace-sidenav__name= current_user.full_name
        %span.workspace-sidenav__caption Your workspace
    %nav.workspace-sidenav__group{ aria: { label: "Workspace" } }
      %h2.workspace-sidenav__heading Workspace
      %ul.nav.flex-column
        %li.nav-item
          = link_to usr_dashboards_path, user_sidenav_link_options(:dashboard) do
            %i.bi.bi-house{ aria: { hidden: "true" } }
            %span Dashboard
        %li.nav-item
          = link_to usr_profile_path(current_profile), user_sidenav_link_options(:my_profile) do
            %i.bi.bi-person{ aria: { hidden: "true" } }
            %span My Profile
        %li.nav-item
          = link_to usr_jobs_path, user_sidenav_link_options(:jobs) do
            %i.bi.bi-briefcase{ aria: { hidden: "true" } }
            %span Jobs
        - if @projects_navigation_path
          %li.nav-item
            = link_to @projects_navigation_path, user_sidenav_link_options(:projects) do
              %i.bi.bi-folder2-open{ aria: { hidden: "true" } }
              %span Projects
    %nav.workspace-sidenav__group{ aria: { label: "Network" } }
      %h2.workspace-sidenav__heading Network
      %ul.nav.flex-column
        %li.nav-item
          = link_to usr_network_path, user_sidenav_link_options(:network) do
            %i.bi.bi-person-lines-fill{ aria: { hidden: "true" } }
            %span My Network
        %li.nav-item
          = link_to usr_profiles_path, user_sidenav_link_options(:people) do
            %i.bi.bi-people{ aria: { hidden: "true" } }
            %span People
        %li.nav-item
          = link_to usr_companies_path, user_sidenav_link_options(:companies) do
            %i.bi.bi-buildings{ aria: { hidden: "true" } }
            %span Companies
    %nav.workspace-sidenav__group{ aria: { label: "Inbox" } }
      %h2.workspace-sidenav__heading Inbox
      %ul.nav.flex-column
        %li.nav-item
          = link_to usr_job_offers_path, user_sidenav_link_options(:offers) do
            %i.bi.bi-calendar2-check{ aria: { hidden: "true" } }
            %span Offers & bookings
        %li.nav-item
          = link_to usr_conversations_path, user_sidenav_link_options(:messages) do
            %i.bi.bi-chat-left-text{ aria: { hidden: "true" } }
            %span Messages
        %li.nav-item
          = link_to usr_job_invitations_path, user_sidenav_link_options(:invitations) do
            %i.bi.bi-send{ aria: { hidden: "true" } }
            %span Invitations
        %li.nav-item
          = link_to usr_notifications_path, user_sidenav_link_options(:notifications) do
            %i.bi.bi-bell{ aria: { hidden: "true" } }
            %span Notifications
            - if @unread_notification_count.positive?
              %span.badge.rounded-pill.ms-auto.workspace-sidenav__count= @unread_notification_count
    %nav.workspace-sidenav__group.workspace-sidenav__companies{ aria: { label: "Your companies" } }
      %h2.workspace-sidenav__heading Your companies
      %ul.nav.flex-column
        - if @sidenav_companies.any?
          - @sidenav_companies.each do |company|
            %li.nav-item
              = link_to usr_company_path(company), user_sidenav_link_options(:company, company: company) do
                %i.bi.bi-building.workspace-sidenav__company-icon{ aria: { hidden: "true" } }
                %span= company.name
        - else
          %li.nav-item
            %p.workspace-sidenav__empty No companies yet.
        %li.nav-item
          = link_to new_usr_company_path, user_sidenav_link_options(:create_company) do
            %i.bi.bi-plus-circle{ aria: { hidden: "true" } }
            %span Create Company
    %nav.workspace-sidenav__account{ aria: { label: "Account" } }
      %ul.nav.flex-column
        %li.nav-item
          = link_to usr_settings_path, user_sidenav_link_options(:settings) do
            %i.bi.bi-gear{ aria: { hidden: "true" } }
            %span Settings
        %li.nav-item
          = link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link d-flex align-items-center workspace-sidenav__sign-out" do
            %i.bi.bi-box-arrow-right{ aria: { hidden: "true" } }
            %span Sign Out
