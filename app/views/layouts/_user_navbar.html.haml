%nav.navbar.navbar-light.bg-white.shadow-sm.app-shell-gutter.app-top-nav
  .container-fluid.px-4.d-flex.align-items-center.justify-content-between
    .d-flex.align-items-center.gap-2
      - if current_user.has_completed_user_profile?
        %button.btn.btn-quiet.btn-icon.btn-sm.d-lg-none{ type: "button", data: { bs_toggle: "offcanvas", bs_target: "#userSidenav" }, aria: { controls: "userSidenav", label: "Open menu" } }
          %i.bi.bi-list
      %a.navbar-brand{ href: "#" }
        = render Shared::CrewbaseLogoTextComponent.new
    .dropdown
      = button_tag type: "button", class: "avatar-toggle dropdown-toggle", data: { bs_toggle: "dropdown" }, aria: { expanded: "false" } do
        = render Usr::Shared::UserAvatarIconComponent.new(user: current_user, size: 40)
      %ul.dropdown-menu.dropdown-menu-end.mt-2.user-nav-dropdown
        - if current_user.has_completed_user_profile?
          %li
            = link_to usr_profile_path(current_user.user_profile), class: "dropdown-item d-flex align-items-center gap-2" do
              %i.bi.bi-person
              Profile
        %li
          = link_to usr_settings_path, class: "dropdown-item d-flex align-items-center gap-2" do
            %i.bi.bi-gear
            Settings
        %li
          %hr.dropdown-divider
        %li
          = link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item d-flex align-items-center gap-2" do
            %i.bi.bi-box-arrow-right
            Sign Out
