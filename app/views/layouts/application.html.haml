!!!
%html
  %head
    %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= @page_title || "crewbase"
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    %meta{:content => "yes", :name => "apple-mobile-web-app-capable"}/
    %meta{:content => "yes", :name => "mobile-web-app-capable"}/
    %meta{property: "og:title", content: "Crewbase"}
    %meta{name: "description", content: @meta_description || "Crewbase helps live event professionals find work, build trusted crews, and manage staffing."}
    %meta{property: "og:description", content: @meta_description || "Crewbase helps live event professionals find work, build trusted crews, and manage staffing."}
    -# %meta{property: "og:image", content: image_url('campus_clash_logo.png')}
    %meta{property: "og:url", content: request.original_url}
    %meta{name: "twitter:card", content: "summary_large_image"}
    %meta{name: "twitter:title", content: "Crewbase"}
    %meta{name: "twitter:description", content: @meta_description || "Crewbase helps live event professionals find work, build trusted crews, and manage staffing."}
    -# %meta{name: "twitter:image", content: image_url('campus_clash_logo.png')}
    %link{ rel: "preconnect", href: "https://fonts.googleapis.com" }
    %link{ rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: "anonymous" }
    %link{ rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" }
    %link{ rel: "stylesheet", href: "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" }
    -# %link{ rel: "apple-touch-icon", sizes: "180x180", href: asset_path('campus_clash_logo.png') }
    -# %link{ rel: "icon", type: "image/png", sizes: "192x192", href: asset_path('campus_clash_logo.png') }
    = csrf_meta_tags
    = csp_meta_tag
    = javascript_include_tag "theme", nonce: true, "data-turbo-track": "reload", "data-turbo-eval": "false"
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags
    -# = favicon_link_tag asset_path('campus_clash_text_logo.png')

  %body#page-top{ "data-turbo-prefetch" => "false", data: { controller: "upload-limit", upload_limit_max_value: UploadPolicy::MAX_FILE_SIZE, action: "change->upload-limit#check trix-file-accept->upload-limit#accept trix-attachment-add->upload-limit#upload" } }
    - if Rails.configuration.x.demo_mode
      = render Shared::DemoNoticeComponent.new
    - if @marketing_page
      - unless controller_path == "marketing"
        .d-flex.justify-content-end.p-3
          = render Shared::ThemePickerComponent.new
      = render "layouts/flash"
      = yield
    - elsif current_user&.site_admin? && controller_path.start_with?("admin/")
      = render Admin::NavigationComponent.new(section: controller_name) do |navigation|
        - navigation.with_appearance do
          = render Shared::ThemePickerComponent.new
      .app-content
        .container-fluid.p-4
          = render "layouts/flash"
          = yield
    - elsif current_user && (current_user.has_role?(:user) || current_user.site_admin?)
      = render "layouts/user_navbar"
      - if workspace_navigation_visible?
        .offcanvas.offcanvas-start{ id: "userSidenav", tabindex: "-1", aria: { labelledby: "userSidenavLabel" } }
          .offcanvas-header
            %h2.offcanvas-title#userSidenavLabel Your workspace
            %button.btn-close{ type: "button", data: { bs_dismiss: "offcanvas" }, aria: { label: "Close navigation" } }
          .offcanvas-body.p-0
            = render "layouts/user_sidenav"
      .app-content
        .container-fluid
          .user-layout.d-flex.align-items-start.gap-4.mt-4
            - if workspace_navigation_visible?
              .d-none.d-lg-block.app-sticky-sidenav
                = render "layouts/user_sidenav"
            .user-main.flex-grow-1
              .container-fluid.user-page-content
                = render "layouts/flash"
                #upload-errors{ aria: { live: "assertive" } }
                = yield
    - else
      .d-flex.justify-content-end.p-3
        = render Shared::ThemePickerComponent.new
      .app-content
        = render "layouts/flash"
        = yield
    
    = turbo_frame_tag "remote_modal", target: "_top", data: { controller: "remote-modal", action: "turbo:before-render@document->remote-modal#hideBeforeRender turbo:submit-end->remote-modal#closeOnSuccess turbo:frame-load->remote-modal#showModal" }
    - unless content_for?(:hide_default_footer)
      %footer.text-center.mt-5.mb-3.text-muted
        © #{Time.current.year} Crewbase
