- flash.each do |type, message|
  - next if message.blank?
  - alert_class = case type.to_s
  - when "notice" then "alert-success"
  - when "alert" then "alert-danger"
  - else "alert-info"
  .alert.alert-dismissible.fade.show.mb-4{ class: alert_class, role: "alert" }
    %i.bi{ class: type.to_s == "notice" ? "bi-check-circle-fill me-2" : type.to_s == "alert" ? "bi-exclamation-triangle-fill me-2" : "bi-info-circle-fill me-2" }
    = message
    %button.btn-close.text-white{ type: "button", data: { bs_dismiss: "alert" }, aria: { label: "Close" } }
