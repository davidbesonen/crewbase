.container.py-5
  .mx-auto{ style: "max-width: 720px;" }
    = link_to root_path, class: "d-inline-block mb-4" do
      = render Shared::CrewbaseLogoTextComponent.new
    .card.border-0.shadow-sm
      .card-body.p-4.p-lg-5
        %p.text-uppercase.text-muted.small.fw-semibold Personal invitation
        %h1.h2 You’ve been invited to apply
        %p.lead
          #{@invitation.invited_by.full_name} invited you to apply for
          %strong= @invitation.job.title
          at #{@invitation.job.company.name}.
        - if current_user
          = button_to "Apply now", accept_public_job_invitation_path(@invitation.token), method: :patch, class: "btn btn-primary"
        - else
          %p Create a Crewbase account with #{@invitation.email}, or sign in to apply.
          .d-flex.flex-wrap.gap-2
            = link_to "Create an account to apply", new_user_registration_path(user: { email: @invitation.email }), class: "btn btn-primary"
            = link_to "Sign in", new_user_session_path, class: "btn btn-outline-primary"
        .mt-3
          = link_to "View posting details", public_job_posting_path(@invitation.job), class: "text-muted"
