.container.py-5
  .row.justify-content-center
    .col-12.col-md-8.col-lg-6
      .card.border-0.shadow-sm
        .card-body.p-4.p-lg-5
          %h1.h3.fw-bold.mb-3 This Invitation Is Unavailable
          %p.text-muted This link may have expired, been replaced, or already been used. Ask the company that invited you for a fresh link if you still need to set up your profile.
          %p.small.text-muted Already claimed your profile? Sign in to access your account.
          = link_to "Sign In To KnowShow", new_user_session_path, class: "btn btn-primary"
