%main.marketing-home{ data: { marketing_homepage: true, brand_concept: brand_concept, controller: "marketing-motion" } }
  %nav.marketing-nav{ aria: { label: "Primary navigation" } }
    .marketing-container.marketing-nav__inner
      = link_to root_path, class: "marketing-brand", aria: { label: "KnowShow home" } do
        = brand
      .marketing-nav__links
        = link_to "How it works", "#how-it-works", class: "marketing-nav__anchor"
        = link_to "For crew", "#for-crew", class: "marketing-nav__anchor"
        = link_to "For companies", "#for-companies", class: "marketing-nav__anchor"
        = link_to "Pricing", "#pricing", class: "marketing-nav__anchor"
        = link_to "Meet the Team", meet_the_team_path, class: "marketing-nav__anchor"
        = link_to "What’s new", change_log_entries_path, class: "marketing-nav__anchor"
      .marketing-nav__actions
        = appearance
        - if show_auth_links
          = link_to "Sign in", new_user_session_path, class: "btn btn-quiet"
        = link_to primary_cta_label, primary_cta_path, class: "btn btn-primary"

  %section.marketing-hero
    .marketing-container.marketing-hero__grid
      .marketing-hero__copy{ data: { marketing_motion_target: "reveal", marketing_motion_direction: "left" } }
        .marketing-eyebrow
          %span.marketing-eyebrow__dot
          The live music touring network
        %h1
          Know your crew.
          %span Own the show.
        %p.marketing-hero__lede
          Your people. Your next show. Connect with touring crew, musicians and engineers who know the work, then keep every booking moving.
        .marketing-hero__actions
          = link_to primary_cta_label, primary_cta_path, class: "btn btn-primary btn-lg"
          = link_to "See how it works", "#how-it-works", class: "btn btn-outline-primary btn-lg"
        .marketing-proof{ aria: { label: "KnowShow benefits" } }
          %span
            %i.bi.bi-check-circle-fill
            Profiles built for touring
          %span
            %i.bi.bi-check-circle-fill
            Clear, explainable matches
          %span
            %i.bi.bi-check-circle-fill
            Staffing through show day

      .marketing-hero__scene{ data: { marketing_motion_target: "reveal parallax", marketing_motion_direction: "right" } }
        = concert_scene

  %section.marketing-trust-strip
    .marketing-container{ data: { marketing_motion_target: "reveal" } }
      %p One practical workspace for the people who take live music on the road.
      .marketing-trust-strip__items
        %span Concerts
        %span Festivals
        %span Touring crew
        %span Touring
        %span Musicians
        %span Engineers

  %section.marketing-section#how-it-works
    .marketing-container
      .marketing-section-heading{ data: { marketing_motion_target: "reveal" } }
        %span.marketing-kicker From search to show day
        %h2 Staffing should feel organized from the start.
        %p KnowShow replaces scattered posts, texts, and spreadsheets with a workflow everyone can understand.
      .marketing-steps
        %article.marketing-step{ data: { marketing_motion_target: "reveal", marketing_motion_stagger: "0" } }
          %span.marketing-step__number 01
          %i.bi.bi-person-vcard
          %h3 Show what you do
          %p Build a useful professional profile or company presence with occupations, broad capabilities, equipment families, specific experience, verified KnowShow Credits, and availability.
        %article.marketing-step{ data: { marketing_motion_target: "reveal", marketing_motion_stagger: "1" } }
          %span.marketing-step__number 02
          %i.bi.bi-search-heart
          %h3 Find the right fit
          %p Search people and jobs, see relevant recommendations, and understand exactly why each opportunity or crew member matches.
        %article.marketing-step{ data: { marketing_motion_target: "reveal", marketing_motion_stagger: "2" } }
          %span.marketing-step__number 03
          %i.bi.bi-kanban
          %h3 Confirm bookings together
          %p Invite, apply, and shortlist, then send clear offer terms for crew to review and accept before a booking is confirmed.

  %section.marketing-section.marketing-section--tinted#for-crew
    .marketing-container
      .marketing-audience-heading{ data: { marketing_motion_target: "reveal", marketing_motion_direction: "left" } }
        .marketing-audience-icon
          %i.bi.bi-headset
        %div
          %span.marketing-kicker For crew members
          %h2 Show what you can do. Find work that fits.
          %p Make it easy for the right production teams to understand your experience and know when you can work.
      .marketing-bento
        %article.marketing-feature.marketing-feature--wide{ data: { marketing_motion_target: "reveal", marketing_motion_stagger: "0" } }
          .marketing-feature__icon
            %i.bi.bi-person-badge
          %h3 Broad experience, specific strengths
          %p Choose occupations, transferable capabilities and equipment families to match relevant work. Add your own techniques, products and experience examples, alongside verified KnowShow Credits and reviews visible only to company owners.
          .marketing-tag-row
            %span A1 Audio
            %span GrandMA3
            %span ETCP
            %span Touring
        %article.marketing-feature{ data: { marketing_motion_target: "reveal", marketing_motion_stagger: "1" } }
          .marketing-feature__icon
            %i.bi.bi-calendar2-check
          %h3 Availability without back-and-forth
          %p Share availability, block conflicts, and connect an iCal feed. Download confirmed bookings to your calendar so work stays on your schedule.
        %article.marketing-feature{ data: { marketing_motion_target: "reveal", marketing_motion_stagger: "2" } }
          .marketing-feature__icon
            %i.bi.bi-briefcase
          %h3 Jobs worth seeing
          %p Browse structured postings, save roles, and receive recommendations grounded in your profile. Hide suggestions that miss the mark and review offer terms before accepting work.

  %section.marketing-section#for-companies
    .marketing-container
      .marketing-audience-heading{ data: { marketing_motion_target: "reveal", marketing_motion_direction: "right" } }
        .marketing-audience-icon.marketing-audience-icon--navy
          %i.bi.bi-buildings
        %div
          %span.marketing-kicker For production companies
          %h2 Build trusted crews with less friction.
          %p Move quickly without sacrificing context, consistency, or control over your staffing process.
      .marketing-bento
        %article.marketing-feature{ data: { marketing_motion_target: "reveal", marketing_motion_stagger: "0" } }
          .marketing-feature__icon
            %i.bi.bi-people
          %h3 Find qualified people
          %p Search touring roles and named equipment experience, including MA3 / grandMA3 lighting consoles. Use recommendations and match explanations to focus your outreach.
        %article.marketing-feature{ data: { marketing_motion_target: "reveal", marketing_motion_stagger: "1" } }
          .marketing-feature__icon
            %i.bi.bi-ui-checks-grid
          %h3 Structured job postings
          %p Post a single role or organize a multi-position gig, with clear requirements, dates, location, compensation, and application questions.
        %article.marketing-feature.marketing-feature--wide{ data: { marketing_motion_target: "reveal", marketing_motion_stagger: "2" } }
          .marketing-feature__icon
            %i.bi.bi-diagram-3
          %h3 One hiring workflow, end to end
          %p Invite candidates, review applications, build shortlists, and send offers for crew to accept. Keep confirmed bookings and conversations connected to the work.
          .marketing-flow
            %span Post
            %i.bi.bi-arrow-right
            %span Match
            %i.bi.bi-arrow-right
            %span Review
            %i.bi.bi-arrow-right
            %span Crew

  %section.marketing-section.marketing-section--tinted#pricing
    .marketing-container
      .marketing-section-heading{ data: { marketing_motion_target: "reveal" } }
        %span.marketing-kicker Simple, affordable pricing
        %h2 Free for crew. Room for your company to grow.
        %p Build your profile, apply, message, and manage availability for free. Companies can start without a card and upgrade when they need more capacity. All prices are in USD, per company.
      .marketing-price-grid
        - pricing_plans.each_with_index do |plan, index|
          %article.marketing-price-card{ class: ("marketing-price-card--featured" unless plan.free?), data: { marketing_motion_target: "reveal", marketing_motion_stagger: index } }
            - unless plan.free?
              %span.marketing-price-card__badge For growing teams
            %h3= plan.name
            %p.marketing-price-card__price
              %strong= plan.free? ? "Free" : plan.monthly_price
              - unless plan.free?
                %span / month
            %p.marketing-price-card__annual= plan.free? ? "No card. No trial deadline." : "#{plan.annual_price} billed yearly · save #{plan.annual_savings}"
            %ul.marketing-check-list
              - plan.capacity_items.each do |capacity|
                %li
                  %i.bi.bi-check2{ aria: { hidden: true } }
                  = capacity[:label]
            %p= plan.description
            = link_to "Start free", primary_cta_path, class: "btn btn-outline-primary"
      .marketing-founder-offer{ data: { marketing_motion_target: "reveal" } }
        %i.bi.bi-shield-check{ aria: { hidden: true } }
        %div
          %span.marketing-kicker Work comes first
          %h3 No fees to apply. No paid ranking boosts.
          %p.mb-0 Both plans include applications, messaging, recommendations, multi-position staffing, and availability-aware crew planning. Team gives you more jobs, team members, and projects. Paid upgrades open once billing is available; you can start free now.

  %section.marketing-section.marketing-platform#platform
    .marketing-container.marketing-platform__grid
      .marketing-platform__copy{ data: { marketing_motion_target: "reveal", marketing_motion_direction: "left" } }
        %span.marketing-kicker Built around real operations
        %h2 The network gets you connected. The tools keep you there.
        %p KnowShow stays useful after a match is made, keeping the context for each company, opportunity, and working relationship close at hand.
        %p KnowShow bases recommendations on clear, job-relevant details: occupations, skills, equipment experience, location, requirements and known availability.
        %ul.marketing-check-list
          %li
            %i.bi.bi-check2
            %span
              %strong Private crew connections
              to reconnect after completed gigs and share relevant job openings.
          %li
            %i.bi.bi-check2
            %span
              %strong Private project workspaces
              for company owners to organize related postings.
          %li
            %i.bi.bi-check2
            %span
              %strong Contextual messaging and notifications
              with private file sharing around applications and invitations.
          %li
            %i.bi.bi-check2
            %span
              %strong Job documents, saved jobs, crew shortlists, and private reviews
              that keep hiring details organized and make repeat work easier.
      = workspace_preview

  %section.marketing-cta
    .marketing-container
      .marketing-cta__inner{ data: { marketing_motion_target: "reveal" } }
        %span.marketing-kicker Your next crew starts here
        %h2 Spend less time chasing replies. Build with confidence.
        %p Join the shared workspace designed for the people who make live music happen.
        .marketing-cta__actions
          = link_to primary_cta_label, primary_cta_path, class: "btn btn-light btn-lg"
          - if show_auth_links
            = link_to "Already have an account? Sign in", new_user_session_path, class: "marketing-cta__signin"

  %footer.marketing-footer
    .marketing-container.marketing-footer__inner
      .marketing-footer__brand
        = brand
        %span Your people. Your next show.
      = link_to "What’s new", change_log_entries_path
      = link_to "Meet the Team", meet_the_team_path
      %p © #{Time.current.year} KnowShow
