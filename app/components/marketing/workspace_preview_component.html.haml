.marketing-product-preview{ aria: { label: "KnowShow staffing dashboard preview" }, data: { marketing_motion_target: "reveal parallax", marketing_motion_direction: "right" } }
  .marketing-product-preview__topbar
    .marketing-window-dots{ aria: { hidden: true } }
      %span
      %span
      %span
    %span Crew recommendations
    %span.marketing-live-pill On the road
  .marketing-product-preview__body
    .marketing-preview-heading
      %div
        %span.marketing-preview-label Your next great crew
        %strong Summer run / Nashville
      %span.marketing-count Touring
