%main.brand-directions
  .brand-directions__header
    = link_to "knowshow / brand directions", welcome_path, class: "brand-directions__back"
    %p.brand-directions__eyebrow Round two / Signal meets Afterhours
    %h1 Clean shape. A little more edge.
    %p Three hybrids, from subtle movement to a heavier forward lean. Same lowercase wordmark. Two shades of blue.
    %span.brand-directions__note Momentum is the suggested middle ground. Signal remains the app default until you choose.
    .brand-directions__references
      %span Compare the originals:
      = link_to "Signal", welcome_path(concept: "signal")
      = link_to "Afterhours", welcome_path(concept: "afterhours")
  .brand-directions__grid
    - concepts.each_with_index do |concept, index|
      %article.brand-direction{ data: { brand_direction: concept.key } }
        .brand-direction__stage.brand-surface-dark
          %span.brand-direction__number= "0#{index + 1}"
          = wordmarks[index]
        .brand-direction__light.brand-surface-light
          = wordmarks[index]
          %span Light surface
        .brand-direction__body
          %h2= "#{index + 1}. #{concept.name}"
          %p.brand-direction__character= concept.character
          %p= concept.description
          .brand-direction__actions
            = link_to "Preview site", welcome_path(concept: concept.key), class: "btn btn-primary"
            = link_to "Dark SVG", "/brand/knowshow-#{concept.key}-on-dark.svg", download: true
            = link_to "Light SVG", "/brand/knowshow-#{concept.key}-on-light.svg", download: true
