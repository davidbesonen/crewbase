%nav.navbar.navbar-expand-xl.bg-white.border-bottom.app-top-nav.app-shell-gutter.admin-navigation{ aria: { label: "Site administration" } }
  .container-fluid.px-4
    = link_to "KnowShow admin", admin_root_path, class: "navbar-brand fw-bold"
    .ms-auto.me-3= appearance
    %button.navbar-toggler{ type: "button", data: { bs_toggle: "collapse", bs_target: "#adminNavigation" }, aria: { controls: "adminNavigation", expanded: "false", label: "Toggle admin navigation" } }
      %span.navbar-toggler-icon
    .collapse.navbar-collapse#adminNavigation
      .navbar-nav.flex-wrap.ms-auto
        - links.each do |label, path, section|
          = link_to label, path, class: "nav-link px-2 #{@section == section ? 'active fw-bold' : ''}", aria: { current: @section == section ? "page" : nil }
        = link_to usr_dashboards_path, class: "nav-link px-2" do
          %i.bi.bi-arrow-left-circle.me-1{ aria: { hidden: "true" } }
          Workspace
        = link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link px-2" do
          %i.bi.bi-box-arrow-right.me-1{ aria: { hidden: "true" } }
          Sign out
