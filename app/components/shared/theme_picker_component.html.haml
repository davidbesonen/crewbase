%label.theme-picker
  %span.visually-hidden Appearance
  %i.bi.bi-circle-half{ aria: { hidden: "true" } }
  %select.form-select.form-select-sm{ aria: { label: "Appearance" }, title: "Appearance", data: { theme_choice: true } }
    %option{ value: "system" } System
    %option{ value: "light" } Light
    %option{ value: "dark" } Dark
