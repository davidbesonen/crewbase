.notification-card.card.border-0.shadow-sm{
  class: notification.unread? ? "card-accent card-accent-cyan" : "notification-card--read",
  data: { notification_id: notification.id }
}
  .card-body.p-3.p-md-4
    .d-flex.align-items-start.gap-3
      %span.icon-orb.notification-card__icon{ class: ("icon-orb-cyan" if notification.unread?) }
        %i.bi.bi-bell{ aria: { hidden: true } }
      .notification-card__content.flex-grow-1
        .d-flex.justify-content-between.align-items-start.gap-3
          %div
            %p.notification-card__message.mb-1
              %strong= notification.message
            %time.notification-card__timestamp.text-muted.small{ datetime: notification.created_at.iso8601 }= helpers.l(notification.created_at, format: :notification)
          - if notification.unread?
            = link_to "Mark read", helpers.read_usr_notification_path(notification), class: "notification-action-link", data: { turbo_method: :patch }
        - if notification.notifiable_type == "JobInvitation" && notification.notifiable.pending?
          .notification-card__actions.d-flex.flex-wrap.gap-3.mt-3
            = link_to "View job", helpers.usr_job_path(notification.notifiable.job), class: "notification-action-link"
            = link_to "Apply now", helpers.accept_usr_job_invitation_path(notification.notifiable), class: "notification-action-link", data: { turbo_method: :patch }
            = link_to "Decline", helpers.decline_usr_job_invitation_path(notification.notifiable), class: "notification-action-link", data: { turbo_method: :patch }
          .mt-3
            = form_with url: helpers.usr_job_invitation_contextual_messages_path(notification.notifiable), scope: :contextual_message, class: "notification-card__message-form d-flex gap-2" do |form|
              = form.text_field :body, class: "form-control", required: true, maxlength: 5000, placeholder: "Ask about this invitation", aria: { label: "Message about this invitation" }
              = form.submit "Send", class: "notification-action-link notification-action-link--button"
        - if notification.notifiable_type == "ContextualMessage"
          .notification-card__actions.mt-3
            = link_to "Open conversation", helpers.usr_conversation_path(notification.notifiable.conversation), class: "notification-action-link"
        - if notification.kind == "crewbase_credit_earned" && notification.notifiable_type == "Credit"
          .notification-card__actions.d-flex.align-items-center.flex-wrap.gap-3.mt-3
            = helpers.crewbase_credit_badge(variant: :blue)
            = link_to "Review profile credit settings",
              helpers.edit_usr_profile_path(notification.notifiable.profile, source: "completed_profile", anchor: "credits_form"),
              class: "notification-action-link"
