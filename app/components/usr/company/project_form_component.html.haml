= helpers.simple_form_for project, url: form_url do |f|
  .card.border-0.shadow-sm
    .card-body.p-4
      = f.error_notification
      = f.input :name, label: "Tour, festival or project name", placeholder: "e.g. Summer tour or festival weekend", input_html: { autofocus: true }
      %p.text-muted.small A Project is your tour, festival or event. Name it, add the shows and cities, then staff roles for the entire run or selected shows. Only the name is required.
      %details.staffing-form__options.mt-4{ open: options_expanded?, data: { project_options: true } }
        %summary.fw-semibold Project Details (Optional)
        .row.g-3.mt-1
          .col-12
            = f.input :description, as: :text, input_html: { rows: 3 }, hint: "A short overview for your company. Project details are private."
          .col-md-4
            = f.input :starts_on, as: :string, input_html: { type: "date", value: project.starts_on&.iso8601 }
          .col-md-4
            = f.input :ends_on, as: :string, input_html: { type: "date", value: project.ends_on&.iso8601 }
          .col-md-4
            = f.input :status, collection: Project.statuses.keys.map { |status| [status.humanize, status] }, include_blank: false
        %p.form-text.mb-0 Project dates provide a starting point for new jobs. Each job can have its own schedule.
      .staffing-form__actions.mt-4
        = link_to "Cancel", project.persisted? ? usr_project_path(project) : usr_company_projects_path(company), class: "btn btn-quiet"
        .d-flex.flex-wrap.gap-2
          - if project.new_record?
            = f.submit "Create project only", class: "btn btn-quiet"
            = button_tag "Create project & post a job", name: "next_step", value: "post_job", class: "btn btn-outline-primary"
            = button_tag "Create Project & Add Shows", name: "next_step", value: "add_shows", class: "btn btn-primary"
          - else
            = f.submit "Save changes", class: "btn btn-primary"
