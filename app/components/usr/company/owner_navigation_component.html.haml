.card.border-0.shadow-sm.mb-3{ data: { company_owner_nav: true } }
  .card-body.py-3
    .d-md-none{ data: { controller: "workspace-navigation" } }
      = label_tag "workspace_#{company.id}", "Company Workspace", class: "form-label small text-muted mb-1"
      = select_tag "workspace_#{company.id}", options_for_select(mobile_options), class: "form-select", aria: { label: "Company workspace destination" }, data: { action: "change->workspace-navigation#navigate" }
    %nav.company-workspace-nav.d-none.d-md-flex.flex-wrap.align-items-center.gap-2{ aria: { label: "Company workspace" } }
      %span.text-muted.fw-semibold.me-2
        %i.bi.bi-building-gear.me-1{ aria: { hidden: true } }
        Company Workspace
      - destinations.each do |item|
        = link_to item.path, class: button_class(item.key), aria: { current: current_destination(item.key) } do
          %i.me-1{ class: "bi bi-#{item.icon}", aria: { hidden: true } }
          = item.label
