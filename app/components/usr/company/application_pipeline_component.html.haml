.application-pipeline
  %header.pipeline-heading
    %div
      %h1.h3.fw-bold.mb-2 Application Pipeline
      %p.text-muted.mb-0
        = "#{total_count} total #{'application'.pluralize(total_count)} for #{company.name}"
    = link_to back_link.fetch(:label), back_link.fetch(:path), class: "btn btn-quiet"

  .pipeline-job-context{ data: { pipeline_job_context: true } }
    %i.bi.bi-briefcase{ aria: { hidden: true } }
    %div
      %span.pipeline-context-label= selected_job ? "Viewing applicants for" : "Company workspace"
      - if selected_job
        = link_to selected_job.title, usr_job_path(selected_job), class: "pipeline-context-title"
      - else
        %span.pipeline-context-title= filters[:project_id] ? "All jobs in this project" : "All jobs"

  %nav.pipeline-stages{ aria: { label: "Application stages" } }
    = link_to usr_company_applications_path(company, filters.except(:status)), class: "pipeline-stage", aria: { current: current_stage(nil) } do
      %span All stages
      %span.pipeline-stage-count= total_count
    - pipeline_statuses.each do |status|
      = link_to usr_company_applications_path(company, filters.merge(status: status)), class: "pipeline-stage", aria: { current: current_stage(status) }, data: { pipeline_stage: status } do
        %span= status.humanize.titleize
        %span.pipeline-stage-count= stage_counts.fetch(status, 0)

  .pipeline-workspace
    = form_with url: usr_company_applications_path(company), method: :get, class: "pipeline-filters" do |form|
      - if filters[:project_id]
        = form.hidden_field :project_id, value: filters[:project_id]
      - if return_context
        = form.hidden_field :return_to, value: filters[:return_to]
      .pipeline-filter-applicant
        = form.label :query, "Applicant", class: "form-label"
        = form.search_field :query, value: filters[:query], class: "form-control", placeholder: "Search by name", styled: true
      %div
        = form.label :job_id, "Job", class: "form-label"
        = form.select :job_id, options_from_collection_for_select(jobs, :id, :title, filters[:job_id]), { include_blank: "All jobs" }, class: "form-select"
      %div
        = form.label :status, "Stage", class: "form-label"
        = form.select :status, options_for_select(pipeline_statuses.map { |status| [ status.humanize.titleize, status ] }, filters[:status]), { include_blank: "All stages" }, class: "form-select"
      .pipeline-filter-actions
        = form.submit "Filter", class: "btn btn-primary"
        = link_to "Clear", usr_company_applications_path(company, clear_filters), class: "btn btn-quiet"

    .pipeline-results-summary
      = "Showing #{applications.length} #{'application'.pluralize(applications.length)}"

    - if applications.any?
      .pipeline-applicants
        - applications.each do |application|
          %article{ class: application_row_classes(application), data: { pipeline_application: application.id } }
            .pipeline-applicant-heading
              %div
                %h2.h5.fw-semibold.pipeline-applicant-name{ data: recommendation_heading_data(application) }
                  = link_to application.profile.user.full_name, usr_profile_path(application.profile), class: "text-dark text-decoration-none"
                  - if recommendation_for(application)
                    %span.badge.text-bg-success.recommended-applicant-badge
                      %i.bi.bi-stars.me-1{ aria: { hidden: true } }
                      Recommended Applicant
                .pipeline-applicant-meta
                  = link_to application.job.title, usr_job_path(application.job), class: "text-muted"
                  %span.pipeline-meta-divider{ aria: { hidden: true } } •
                  %span= "Applied #{l((application.submitted_at || application.created_at).to_date, format: :long)}"
              %span.pipeline-applicant-status{ class: job_application_status_badge_class(application.status) }
                = status_label(application)
            - if recommendation_for(application)
              .pipeline-recommendation{ data: { recommendation_reason: true } }
                %span= recommendation_summary(application)
            .pipeline-applicant-actions
              = link_to "View Application", usr_job_application_path(application), class: "btn btn-quiet btn-sm"
              .pipeline-status-actions{ data: { pipeline_actions: true } }
                - if offer_for(application)
                  = link_to offer_link_label(application), usr_job_offer_path(offer_for(application)), class: "btn btn-outline-primary btn-sm"
                - pipeline_action_statuses(application).each do |status|
                  - if status == "accepted"
                    = link_to transition_label(status), new_usr_job_offer_path(job_application_id: application.id), class: "btn btn-outline-primary btn-sm"
                  - elsif current_status?(application, status)
                    %button.btn.btn-secondary.btn-sm{ type: "button", disabled: true, aria: { disabled: "true" } }
                      = transition_label(status)
                  - else
                    = link_to transition_label(status), update_status_usr_job_application_path(application, status: status), class: "btn btn-outline-primary btn-sm", data: { turbo_method: :patch, turbo_confirm: "Move this application to #{status.humanize.titleize}?" }
    - else
      .pipeline-empty-state
        %i.bi.bi-inbox{ aria: { hidden: true } }
        %h2.h5 No Applications Found
        %p.text-muted.mb-0 Adjust the filters or check back after candidates apply.
