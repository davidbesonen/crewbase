.row.justify-content-center
  .col-12.col-lg-8
    .card.border-0.shadow-sm
      .card-body.p-4.p-lg-5
        .d-flex.justify-content-between.align-items-start.gap-3.mb-3
          %h1.fw-bold.mb-0= @offer.role
          %span.status-badge{ class: @summary.status_class }= @summary.label
        %p.text-muted #{@offer.job.company.name} · #{@offer.profile.user.full_name}
        %dl.row
          %dt.col-sm-4 Work dates
          %dd.col-sm-8 #{l(@offer.starts_at, format: :long)} – #{l(@offer.ends_at, format: :long)} (#{Time.zone.name})
          %dt.col-sm-4 Agreed rate
          %dd.col-sm-8 #{@offer.currency} #{number_with_precision(@offer.rate, precision: 2)} / #{@offer.pay_unit.humanize.downcase}
          - if @offer.expires_at
            %dt.col-sm-4 Respond by
            %dd.col-sm-8= l(@offer.expires_at, format: :long)
        - if @offer.terms.present?
          %h2.h6 Essential Terms
          = simple_format(@offer.terms)
        - if @offer.cancelled?
          .alert.alert-secondary
            Booking cancelled by #{@offer.cancelled_by.full_name}.
            = @offer.cancellation_reason
        - if @summary.state == "pending"
          .alert.alert-info
            %p.mb-1 Pending offers do not reserve a position. This booking is confirmed only after the worker accepts.
            %p.mb-0= @availability.label
          .d-flex.flex-wrap.gap-2
            - if @recipient_view
              = button_to "Accept offer", usr_job_offer_path(@offer), method: :patch, params: { decision: "accept" }, class: "btn btn-primary", data: { turbo_confirm: "Confirm the dates and terms and accept this booking?" }
              = button_to "Decline", usr_job_offer_path(@offer), method: :patch, params: { decision: "decline" }, class: "btn btn-outline-secondary"
            - if @owner_view
              = button_to "Withdraw offer", usr_job_offer_path(@offer), method: :patch, params: { decision: "withdraw" }, class: "btn btn-outline-danger"
              = link_to "Send revised terms", new_usr_job_offer_path(job_application_id: @offer.job_application_id, crew_position_id: @offer.crew_position_id), class: "btn btn-outline-primary"
        - if @offer.accepted? && !@offer.job.conversation_archived? && @offer.ends_at > Time.current
          .alert.alert-success Booking confirmed. Changes to the agreed terms require cancellation and a new offer.
          %details.border.rounded-3.p-3.mt-3
            %summary.text-danger.fw-semibold Cancel This Booking
            = form_with url: usr_job_offer_path(@offer), method: :patch, builder: ActionView::Helpers::FormBuilder, class: "mt-3" do |form|
              = form.hidden_field :decision, value: "cancel"
              .mb-3
                = form.label :reason, "Cancellation reason", class: "form-label"
                = form.text_area :reason, required: true, maxlength: 2000, class: "form-control", rows: 2
              = form.submit "Cancel booking", class: "btn btn-outline-danger", data: { turbo_confirm: "Cancel this confirmed booking? Both parties will be notified." }
        - if @offer.accepted?
          .mt-4
            = link_to calendar_usr_job_offer_path(@offer), class: "btn btn-outline-primary", data: { turbo: false } do
              %i.bi.bi-calendar-plus.me-2{ aria: { hidden: true } }
              Add to calendar
            %p.small.text-muted.mt-2.mb-0 Download an .ics file for your calendar. Later booking changes won’t sync automatically.
        .d-flex.flex-wrap.gap-2.mt-4
          = link_to "View application & conversation", usr_job_application_path(@offer.job_application), class: "btn btn-outline-secondary"
          = link_to "All offers", usr_job_offers_path, class: "btn btn-outline-secondary"
