.row.justify-content-center
  .col-12.col-lg-9.col-xl-8
    .card.border-0.shadow-sm
      .card-body.p-4.p-lg-5
        %h1.fw-bold What brings you to Crewbase?
        %p.text-muted Find work or hire crew and musicians in live music touring. Start with what you need today; add more profile details later.
        - if quick_start.errors.any?
          .alert.alert-danger{ role: "alert" }= quick_start.errors.full_messages.to_sentence
        = form_with url: usr_onboarding_path, method: :patch, scope: :onboarding, builder: ActionView::Helpers::FormBuilder do |form|
          %fieldset.mb-4
            %legend.h5 I’m here to…
            .row.g-3
              - CompleteQuickStart::INTENTS.each do |value, label|
                .col-md-4
                  %label.card.h-100.p-3.d-flex.flex-row.align-items-center.gap-2.quick-start-choice
                    = form.radio_button :intent, value, checked: quick_start.intent == value, required: true, class: "form-check-input"
                    %span.fw-semibold= label
          .mb-4
            %details
              %summary.fw-semibold.py-2 Choose your roles (optional)
              %fieldset.quick-start-roles.border.rounded.p-3.mt-2{ aria: { describedby: "quick-start-roles-help" } }
                %legend.visually-hidden What roles do you do?
                .row.g-2
                  - occupations.each do |occupation|
                    .col-sm-6
                      %label.d-flex.align-items-center.gap-2.py-2
                        = check_box_tag "onboarding[occupation_ids][]", occupation.id, Array(quick_start.occupation_ids).map(&:to_s).include?(occupation.id.to_s), id: "quick_start_occupation_#{occupation.id}", class: "form-check-input mt-0"
                        %span= occupation.name
            %p.text-muted.small.mt-2#quick-start-roles-help Optional. Choose up to eight roles to improve your recommendations. Skills, equipment, credits, and availability can come later. Your profile is not published by this step.
          .d-flex.flex-wrap.gap-3.align-items-center
            = form.submit "Get started", class: "btn btn-primary"
            = link_to "Browse jobs first", usr_jobs_path, class: "btn btn-outline-primary"
