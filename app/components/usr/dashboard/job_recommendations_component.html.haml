.card.h-100{ data: { open_jobs_card: true } }
  .card-body
    %h5.card-title.fw-semibold.mb-3
      %i.bi.bi-stars.text-primary.me-1{ aria: { hidden: true } }
      Jobs Recommended For You
    - if results.any?
      .d-flex.flex-column.gap-3
        - results.each do |result|
          .pb-3.border-bottom{ data: { worker_job_recommendation: true } }
            .d-flex.justify-content-between.align-items-start.gap-3
              %div
                .fw-semibold
                  = link_to result.job.title, job_path(result.job), class: "text-dark text-decoration-none"
                .text-muted.small
                  - if result.job.company
                    = link_to result.job.company.name,
                      company_path(result.job.company),
                      class: "text-muted text-decoration-none"
                  - else
                    Unassigned Company
                .d-flex.flex-wrap.gap-2.mt-2
                  - result.match_reasons.each do |reason|
                    %span.badge.text-bg-light.border.fw-normal= reason
              .text-end.flex-shrink-0
                - if applied?(result.job)
                  %span.badge.bg-success-subtle.text-success-emphasis.border Applied
                - if result.job.compensation_range.present?
                  .fw-semibold.mt-1= result.job.compensation_range
                  - if result.job.pay_period.present?
                    .text-muted.small= result.job.pay_period.humanize
                .text-muted.small= result.job.relative_published_at
            %details.mt-2
              %summary.small.text-muted Not Interested?
              = form_with url: usr_job_recommendation_feedback_path(result.job.id), builder: ActionView::Helpers::FormBuilder, class: "d-flex flex-wrap gap-2 mt-2" do |form|
                = form.label :reason, "Why hide this recommendation?", for: "feedback_reason_#{result.job.id}", class: "visually-hidden"
                = form.select :reason, RecommendationFeedback::REASONS.map { |key, label| [label, key] }, {}, id: "feedback_reason_#{result.job.id}", class: "form-select form-select-sm w-auto"
                = form.submit "Hide recommendation", class: "btn btn-sm btn-outline-secondary"
      .mt-3
        = link_to "View More Jobs", jobs_path, class: "text-muted text-decoration-none fw-semibold"
    - else
      %div{ data: { job_matches_empty: true } }
        - if matching_profile
          %p.card-text.text-muted.mb-2 No suitable openings match your profile and availability right now.
          .d-flex.flex-wrap.gap-3
            = link_to "Browse Jobs", jobs_path, class: "btn btn-outline-primary btn-sm"
            = link_to "Edit Matching Details", edit_profile_path, class: "text-muted text-decoration-none fw-semibold align-self-center"
        - else
          %p.card-text.text-muted.mb-2 Add occupations, skills, or equipment to your profile so we can match you with relevant jobs.
          .d-flex.flex-wrap.gap-3
            = link_to "Add Matching Details", edit_profile_path, class: "btn btn-outline-primary btn-sm"
            = link_to "Browse Jobs", jobs_path, class: "text-muted text-decoration-none fw-semibold align-self-center"
    .mt-3
      = link_to "Hidden recommendations", usr_recommendation_feedback_index_path, class: "small text-muted"
