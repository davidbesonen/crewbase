%nav.dashboard-tools{ aria: { label: "Helpful tools" }, data: { helpful_tools: true } }
  %span.visually-hidden Helpful Tools
  - tools.each do |tool|
    = link_to tool.path, class: class_names("dashboard-tool", "dashboard-tool--primary": tool.primary) do
      %i.bi{ class: "bi-#{tool.icon}", aria: { hidden: true } }
      %span= tool.label
