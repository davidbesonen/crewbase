.staffing-form.staffing-form--project{ data: { staffing_start: true } }
  .mb-4
    %p.small.text-muted.mb-2 Choose Your Gig Structure
    %h1.fw-bold.mb-2 Staff a Gig
    %p.text-muted.mb-0 Start with the shape of the work. You’ll add dates, roles and crew next.
  - if @start.errors.any?
    .alert.alert-warning{ role: "alert" }= error_message
  = form_with model: @start, scope: :staffing, url: usr_staffing_start_path, builder: ActionView::Helpers::FormBuilder do |form|
    .card.border-0.shadow-sm.mb-4
      .card-body.p-4
        - if @companies.one?
          = form.hidden_field :company_id
          .small.text-muted Staffing For
          .fw-semibold.mb-4= @companies.first.name
        - else
          .mb-4
            = form.label :company_id, "Company", class: "form-label fw-semibold"
            = form.collection_select :company_id, @companies, :id, :name, { prompt: "Choose your company" }, required: true, class: "form-select"
        %fieldset
          %legend.h5.fw-semibold.mb-3 What Are You Staffing?
          .d-grid.gap-3
            - choices.each do |choice|
              %label.staffing-choice{ for: "staffing_kind_#{choice.key}" }
                = form.radio_button :kind, choice.key, required: true, id: "staffing_kind_#{choice.key}", class: "form-check-input"
                %span.staffing-choice__icon
                  %i.bi{ class: "bi-#{choice.icon}", aria: { hidden: true } }
                %span
                  %span.d-block.fw-semibold.mb-1= choice.title
                  %span.d-block.small.text-muted= choice.description
        %p.form-text.mt-3.mb-0 A single gig can still need several roles and people. This choice decides whether the shows need a shared project.
    .staffing-form__actions
      = link_to "Back To Dashboard", usr_dashboards_path, class: "btn btn-quiet"
      = form.button "Continue", class: "btn btn-primary"
    .mt-4
      = link_to "Continue An Existing Project", @projects_path, class: "small"
